# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
*.mobileprovision
service-account.json
credentials.json
secrets.*

# macOS
.DS_Store

# Xcode (user-specific, never committed)
*.xcuserstate
xcuserdata/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
.next/
dist/
build/
coverage/
DerivedData/
*.xcarchive
*.ipa
*.tsbuildinfo

# TS emitted artifacts that should never live next to sources (defensive:
# tsc must emit into dist/; if it ever leaks .js/.d.ts/.map into src/, ignore it).
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
services/*/src/**/*.js
services/*/src/**/*.js.map
services/*/src/**/*.d.ts
services/*/src/**/*.d.ts.map

# Local dev runtime state (scripts/dev.sh)
.dev/

# IDE
.vscode/settings.json
.idea/

# Local tooling
.venv/
.python-version

# Local databases / caches
*.db
*.sqlite
*.sqlite3
.cache/
.tmp/

# Logs
*.log
