# UNSTUCK API — local development environment example.
#
# This file is a NON-SECRET template. Copy it to `.env` (which is gitignored)
# and fill in local-only values. NEVER commit real secrets. Production secrets
# live in secure secret stores, never in Git (docs/SECURITY.md).
#
# .env is gitignored; .env.example is intentionally allowed.

NODE_ENV=local
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Base URL the iOS client uses to reach this API. Local/dev only.
API_BASE_URL=http://127.0.0.1:3000

# Ranca AI orchestration boundary. NOT embedded yet. These are *references*,
# never raw credentials. The real provider is wired server-side only.
# Set RANCA_PROVIDER_ID=mock-dev for the development-safe mock (no AI provider, no creds).
RANCA_PROVIDER_ID=mock-dev
RANCA_CREDENTIAL_REF=unset
RANCA_TIMEOUT_MS=10000
