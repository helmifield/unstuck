{
  "name": "@unstuck/api",
  "version": "0.0.0",
  "private": true,
  "description": "UNSTUCK NestJS API foundation. No product features; health + config + secure defaults.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:dev": "node --watch dist/main.js",
    "watch:build": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@unstuck/contracts": "0.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.2.1",
    "@swc/core": "1.16.0",
    "@types/express": "5.0.0",
    "@types/node": "20.16.5",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.8.0",
    "@typescript-eslint/parser": "8.8.0",
    "eslint": "9.39.5",
    "supertest": "7.2.2",
    "typescript": "5.5.4",
    "unplugin-swc": "1.5.11",
    "vitest": "3.2.7"
  }
}
